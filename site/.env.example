# ============================================================
#  CURA-ME · Ingressos — variáveis de ambiente
#  Copie este arquivo para ".env.local" e preencha os valores.
# ============================================================

# --- Site -----------------------------------------------------
# URL pública do site, SEM barra no final.
# Em produção (Vercel): https://seu-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago --------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Crie uma aplicação → Credenciais de produção → Access Token
MP_ACCESS_TOKEN=

# Assinatura secreta do webhook (Painel → Webhooks → Configurar
# notificações). Recomendado em produção; pode ficar vazio em teste.
MP_WEBHOOK_SECRET=

# --- Supabase (banco de dados, plano grátis) ------------------
# https://supabase.com → seu projeto → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (SMTP) — envio automático dos ingressos -----------
# Com Gmail: ative a verificação em 2 etapas e crie uma
# "Senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Fonte Church

# --- Portaria / validação de ingressos ------------------------
# PIN que a equipe digita na página /validar do site
ADMIN_PIN=
